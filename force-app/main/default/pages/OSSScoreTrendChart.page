<apex:page standardController="Opportunity"
           extensions="OSSScoreTrendController"
           showHeader="false"
           sidebar="false"
           lightningStylesheets="true"
           docType="html-5.0"
           applyHtmlTag="false"
           applyBodyTag="false">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8" />
    <title>OSS Score Trend</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bg:        #ffffff;
            --card:      #ffffff;
            --text:      #1a2440;
            --muted:     #6b7280;
            --border:    #e3e7ee;
            --accent:    #1f3864;
            --accent-2:  rgba(31, 56, 100, 0.18);
            --grid:      #eef0f4;
            --tick:      #4a5568;
            --btn-bg:    #ffffff;
            --btn-text:  #1f3864;
            --btn-hover: #f3f6fb;
            --shadow:    0 1px 2px rgba(0, 0, 0, 0.05);
        }
        body.dark {
            --bg:        #0f172a;
            --card:      #131b2e;
            --text:      #e6e9f2;
            --muted:     #94a3b8;
            --border:    #25304a;
            --accent:    #6ea8ff;
            --accent-2:  rgba(110, 168, 255, 0.30);
            --grid:      #1f2a44;
            --tick:      #b8c2d6;
            --btn-bg:    #1a233b;
            --btn-text:  #c7d2e6;
            --btn-hover: #243054;
            --shadow:    0 1px 2px rgba(0, 0, 0, 0.4);
        }

        html, body { margin: 0; padding: 0; background: var(--bg); }
        body {
            font-family: 'Salesforce Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
            color: var(--text);
            transition: background 0.2s ease, color 0.2s ease;
        }

        .oss-chart-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 14px 16px;
            margin: 8px;
            transition: background 0.2s ease, border-color 0.2s ease;
        }

        .oss-chart-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
            gap: 8px;
            flex-wrap: wrap;
        }
        .oss-chart-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .oss-chart-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--accent);
            letter-spacing: 0.01em;
        }

        .theme-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--btn-bg);
            color: var(--btn-text);
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }
        .theme-toggle:hover { background: var(--btn-hover); }
        .theme-icon { font-size: 14px; line-height: 1; }

        .oss-chart-controls { display: flex; gap: 6px; }
        .oss-chart-controls button {
            padding: 5px 12px;
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--btn-bg);
            color: var(--btn-text);
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }
        .oss-chart-controls button:hover { background: var(--btn-hover); }
        .oss-chart-controls button.active {
            background: var(--accent);
            color: #ffffff;
            border-color: var(--accent);
        }

        .oss-canvas-wrap { position: relative; height: 280px; }
        .oss-empty {
            color: var(--muted);
            font-style: italic;
            padding: 40px 0;
            text-align: center;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="oss-chart-card">
        <div class="oss-chart-header">
            <div class="oss-chart-left">
                <div class="oss-chart-title">OSS Score Trend</div>
                <button id="btn-theme" class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
                    <span class="theme-icon">&#9728;</span>
                    <span class="theme-text">Light</span>
                </button>
            </div>
            <div class="oss-chart-controls">
                <button id="btn-line" onclick="renderChart('line')">Line</button>
                <button id="btn-bar" onclick="renderChart('bar')">Bar</button>
            </div>
        </div>
        <div class="oss-canvas-wrap">
            <canvas id="ossChart"></canvas>
        </div>
        <div id="emptyMsg" class="oss-empty" style="display:none;">No score history yet.</div>
    </div>

    <script>
        var historyJson = [];
        try { historyJson = JSON.parse('{!JSENCODE(historyJson)}'); } catch (e) { historyJson = []; }

        var chart;
        var currentType = 'line';
        var darkMode = false;

        function readVar(name) {
            return getComputedStyle(document.body).getPropertyValue(name).trim();
        }

        function toggleTheme() {
            darkMode = !darkMode;
            document.body.classList.toggle('dark', darkMode);
            var iconEl = document.querySelector('.theme-icon');
            var textEl = document.querySelector('.theme-text');
            if (iconEl) { iconEl.textContent = darkMode ? '🌙' : '☀'; }
            if (textEl) { textEl.textContent = darkMode ? 'Dark' : 'Light'; }
            renderChart(currentType);
        }

        function renderChart(type) {
            currentType = type || 'line';
            document.getElementById('btn-line').classList.toggle('active', currentType === 'line');
            document.getElementById('btn-bar').classList.toggle('active', currentType === 'bar');

            var data = historyJson || [];
            var canvas = document.getElementById('ossChart');
            var emptyEl = document.getElementById('emptyMsg');

            if (!data.length) {
                canvas.style.display = 'none';
                emptyEl.style.display = '';
                return;
            }
            canvas.style.display = '';
            emptyEl.style.display = 'none';

            var labels = data.map(function (d) { return d.date; });
            var scores = data.map(function (d) { return Number(d.score); });

            var accent = readVar('--accent');
            var accent2 = readVar('--accent-2');
            var grid = readVar('--grid');
            var tick = readVar('--tick');

            if (chart) chart.destroy();

            chart = new Chart(canvas, {
                type: currentType,
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Opportunity Score',
                        data: scores,
                        borderColor: accent,
                        backgroundColor: currentType === 'bar' ? accent : accent2,
                        fill: currentType === 'line',
                        tension: 0.25,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: darkMode ? '#1a233b' : '#1a2440',
                            titleColor: '#ffffff',
                            bodyColor: '#ffffff',
                            padding: 8,
                            callbacks: {
                                afterLabel: function (ctx) {
                                    var idx = ctx.dataIndex;
                                    var u = data[idx] && data[idx].user;
                                    return u ? 'By: ' + u : '';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: { color: grid },
                            ticks: { color: tick },
                            title: { display: true, text: 'Score', color: tick }
                        },
                        x: {
                            grid: { color: grid },
                            ticks: { color: tick },
                            title: { display: true, text: 'Date', color: tick }
                        }
                    }
                }
            });
        }

        window.addEventListener('load', function () { renderChart('line'); });
    </script>
</body>
</html>
</apex:page>