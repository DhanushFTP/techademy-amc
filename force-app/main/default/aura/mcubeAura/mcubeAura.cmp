<aura:component implements="lightning:actionOverride,force:lightningQuickAction,force:hasRecordId,force:appHostable"
                access="global">

    <aura:attribute name="recordId" type="String" />

    <!-- Modal sits directly in component body — same trick as complaint cmp -->
    <div role="dialog"
         class="slds-modal slds-fade-in-open slds-modal_medium"
         aria-modal="true"
         aria-labelledby="mcubeModalHeader">
        <div class="slds-modal__container">

            <div class="slds-modal__header">
                <lightning:buttonIcon
                    iconName="utility:close"
                    variant="bare-inverse"
                    alternativeText="Close"
                    class="slds-modal__close"
                    onclick="{!c.closeModal}" />
                <h2 id="mcubeModalHeader"
                    class="slds-text-heading_medium slds-hyphenate">
                    MCube Configuration
                </h2>
            </div>

            <div class="slds-modal__content slds-p-around_medium">
                <!-- ✅ LWC wizard — closemodal event bubbles up here -->
                <c:mcubeConfigWizard
                    recordId="{!v.recordId}"
                    onclosemodal="{!c.closeModal}" />
            </div>

        </div>
    </div>

    <!-- Backdrop -->
    <div class="slds-backdrop slds-backdrop_open"
         onclick="{!c.closeModal}">
    </div>

</aura:component>