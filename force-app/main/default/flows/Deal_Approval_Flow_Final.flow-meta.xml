        <rules>
            <name>In_Period</name>
            <conditionLogic>1 AND 2 AND (3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>CloseDateMonth</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CurrentMonth</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TodayDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
