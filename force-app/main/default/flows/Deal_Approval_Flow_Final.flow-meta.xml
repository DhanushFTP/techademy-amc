    <formulas>
        <name>AmountRestricted</name>
        <dataType>Boolean</dataType>
        <expression>$Record.Amount &lt; ($Record__Prior.Amount * 0.8)</expression>
    </formulas>
    <formulas>
        <name>CloseDateMonth</name>
        <dataType>Number</dataType>
        <expression>MONTH({!$Record__Prior.CloseDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CloseDateRestricted</name>
        <dataType>Boolean</dataType>
        <expression>MONTH($Record.CloseDate) != MONTH($Record__Prior.CloseDate)</expression>
    </formulas>
    <formulas>
        <name>CurrentMonth</name>
        <dataType>Number</dataType>
        <expression>MONTH(TODAY())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>NewCloseDateMonth</name>
        <dataType>Number</dataType>
        <expression>MONTH({!$Record.CloseDate})</expression>
