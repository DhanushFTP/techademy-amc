    <environments>Default</environments>
    <formulas>
        <name>fmDailyEndDT</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT( YEAR({!varCurrentDate}) ) &amp; &quot;-&quot; &amp;
  LPAD(TEXT(MONTH({!varCurrentDate})), 2, &quot;0&quot;) &amp; &quot;-&quot; &amp;
  LPAD(TEXT(DAY({!varCurrentDate})),   2, &quot;0&quot;) &amp; &quot; 20:00:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fmDailyStartDT</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT( YEAR({!varCurrentDate}) ) &amp; &quot;-&quot; &amp;
  LPAD(TEXT(MONTH({!varCurrentDate})), 2, &quot;0&quot;) &amp; &quot;-&quot; &amp;
  LPAD(TEXT(DAY({!varCurrentDate})),   2, &quot;0&quot;) &amp; &quot; 08:00:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fmEndDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!varEndDT})</expression>
    </formulas>
    <formulas>
        <name>fmEndDTForDay</name>
        <dataType>DateTime</dataType>
        <expression>IF(
  DATEVALUE({!varEndDT}) = {!varCurrentDate},
     IF({!varEndDT} &lt; {!fmDailyEndDT}, {!varEndDT}, {!fmDailyEndDT}),
     {!fmDailyEndDT}
)</expression>
    </formulas>
    <formulas>
        <name>fmHoursForDay</name>
        <dataType>Number</dataType>
        <expression>IF({!fmEndDTForDay} &gt; {!fmStartDTForDay},
   ({!fmEndDTForDay} - {!fmStartDTForDay}) * 24,
   0
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fmIsInvalidRange</name>
        <dataType>Boolean</dataType>
        <expression>{!varEndDT} &lt; {!varStartDT}</expression>
    </formulas>
    <formulas>
        <name>fmIsLoopDone</name>
        <dataType>Boolean</dataType>
        <expression>{!varCurrentDate} &gt; {!fmEndDate}</expression>
    </formulas>
    <formulas>
        <name>fmIsSunday</name>
        <dataType>Boolean</dataType>
        <expression>WEEKDAY({!varCurrentDate}) = 1</expression>
    </formulas>
    <formulas>
        <name>fmStartDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!varStartDT})</expression>
    </formulas>
    <formulas>
        <name>fmStartDTForDay</name>
        <dataType>DateTime</dataType>
        <expression>IF(
  DATEVALUE({!varStartDT}) = {!varCurrentDate},
     IF({!varStartDT} &gt; {!fmDailyStartDT}, {!varStartDT}, {!fmDailyStartDT}),
     {!fmDailyStartDT}
)</expression>
    </formulas>
