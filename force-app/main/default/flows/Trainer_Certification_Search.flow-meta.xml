            </connector>
            <label>City exists</label>
        </rules>
        <rules>
            <name>City_is_empty</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Training_City</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Training_City</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Trainers_with_Skills_No_City</targetReference>
            </connector>
            <label>City is empty</label>
        </rules>
    </decisions>
