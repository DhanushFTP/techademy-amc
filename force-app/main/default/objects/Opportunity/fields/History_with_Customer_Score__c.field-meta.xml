<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>History_with_Customer_Score__c</fullName>
    <description>Weighted score for How is our history with this customer?</description>
    <externalId>false</externalId>
    <formula>CASE(
 History_with_Customer__c ,
&quot;Advantageous&quot;, 2,
&quot;Neutral&quot;, 1,
&quot;Never worked&quot;, 0,
&quot;Disadvantageous&quot;, -1,
    0
) * 0.05*100</formula>
    <inlineHelpText>Weighted score for How is our history with this customer?</inlineHelpText>
    <label>History with Customer Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
