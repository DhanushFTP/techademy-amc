<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Customer_Requirement_Fulfilment_Score__c</fullName>
    <externalId>false</externalId>
    <formula>CASE(
  Customer_Requirement_Fulfilment__c   ,
&quot;Yes&quot;, 2,
&quot;Partially, about 50%&quot;, 1,
&quot;Less than 30%&quot;, 0,
&quot;Don&apos;t know&quot;, -1,
 
