<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opportunity_Engaged_Stage_Score__c</fullName>
    <externalId>false</externalId>
    <formula>CASE(
  Opportunity_Engaged_Stage__c   ,
&quot;Need&quot;, 2,
&quot;Want&quot;, 1,
&quot;Requirement&quot;, 0,
&quot;Evaluation&quot;, -1,
 
    0
) * 0.07*100</formula>
    <inlineHelpText>Weighted Score for at what stage did we get engaged with this opportunity?</inlineHelpText>
    <label>Opportunity Engaged Stage Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
