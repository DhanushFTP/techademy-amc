<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Proposed_Solution_Accepted_Score__c</fullName>
    <externalId>false</externalId>
    <formula>CASE(
  Proposed_Solution_Accepted__c   ,
&quot;Accepted&quot;, 2,
&quot;Under discussion&quot;, 1,
&quot;No response&quot;, 0,
&quot;Rework necessary&quot;, -1,
 
    0
) * 0.05*100</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Has the customer principally accepted our proposed solution?</inlineHelpText>
    <label>Proposed Solution Accepted Score</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
